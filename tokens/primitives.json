{
  "$comment": "Raw scales. Never referenced by a component — only by the semantic layer and presets.",
  "space": {
    "0": "0", "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px",
    "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px"
  },
  "radius": {
    "none": "0", "sm": "3px", "md": "5px", "lg": "8px", "xl": "12px", "full": "999px"
  },
  "font": {
    "sans": "Inter, 'Segoe UI', system-ui, -apple-system, sans-serif",
    "mono": "'JetBrains Mono', 'Cascadia Mono', Consolas, monospace"
  },
  "size": {
    "xs": "12px", "sm": "13px", "md": "14px", "lg": "15px",
    "xl": "18px", "2xl": "24px", "3xl": "28px"
  },
  "weight": { "regular": "400", "medium": "500", "semibold": "600" },
  "leading": {
    "xs": "16px", "sm": "19px", "md": "21px", "lg": "22px",
    "xl": "26px", "2xl": "32px", "3xl": "34px"
  },
  "tracking": {
    "tight": "-0.01em", "snug": "-0.005em", "normal": "0",
    "wide": "0.01em", "wider": "0.04em"
  },
  "control": {
    "height-compact": "32px", "height-md": "36px", "height-touch": "44px",
    "row-compact": "32px", "row-md": "40px", "row-touch": "48px"
  },
  "layout": {
    "rail-expanded": "240px", "rail-collapsed": "64px",
    "header": "56px", "context-bar": "44px", "status-bar": "28px",
    "gutter": "24px", "gutter-compact": "16px",
    "content-max": "1600px",
    "dialog-sm": "480px", "dialog-md": "640px", "dialog-lg": "880px"
  },
  "elevation": {
    "none": "none",
    "raised": "0 1px 2px rgba(16, 18, 20, 0.06), 0 1px 3px rgba(16, 18, 20, 0.04)",
    "overlay": "0 4px 12px rgba(16, 18, 20, 0.10), 0 1px 3px rgba(16, 18, 20, 0.06)",
    "dialog": "0 12px 32px rgba(16, 18, 20, 0.16), 0 2px 8px rgba(16, 18, 20, 0.08)"
  },
  "motion": {
    "instant": "80ms", "fast": "140ms", "medium": "220ms",
    "ease": "cubic-bezier(0.2, 0, 0.2, 1)",
    "ease-out": "cubic-bezier(0, 0, 0.2, 1)"
  },
  "border": { "hairline": "1px", "thick": "2px", "focus": "2px" },
  "status": {
    "success": "#1F7A4C", "success-surface": "#E8F5EE", "success-border": "#B7DFC8",
    "warning": "#B26A00", "warning-surface": "#FDF3E3", "warning-border": "#EFD5A8",
    "error":   "#C0392B", "error-surface":   "#FBEAE8", "error-border":   "#EFC2BC",
    "info":    "#1F5F8B", "info-surface":    "#E7F1F8", "info-border":    "#BBD6E8"
  }
}
